{
  "name": "shopify-hubspot-sync",
  "version": "1.0.0",
  "description": "Queue-based Shopify to HubSpot order sync with webhook verification, retries and idempotency",
  "main": "dist/server.js",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
